---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatNewsDate, getNewsEntries, sortNewsByPublishedAt, type NewsEntry } from '../../lib/news';

export async function getStaticPaths() {
  const articles = await getNewsEntries();

  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props as { article: NewsEntry };
const { Content } = await render(article as never);
const relatedArticles = sortNewsByPublishedAt(
  (await getNewsEntries()).filter((entry) => entry.id !== article.id),
).slice(0, 2);
---

<BaseLayout title={article.data.title} description={article.data.excerpt}>
  <article class="news-article container">
    <a class="back-link" href="/actualites/">← Toutes les actualités</a>
    <header class="article-header">
      <p class="article-category">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-excerpt">{article.data.excerpt}</p>
      <div class="article-dates">
        <span>Publié le {formatNewsDate(article.data.publishedAt)}</span>
        {article.data.updatedAt > article.data.publishedAt && (
          <span>Mis à jour le {formatNewsDate(article.data.updatedAt)}</span>
        )}
      </div>
      {article.data.demo && <p class="demo-notice">Contenu fictif de démonstration — aucune actualité réelle.</p>}
    </header>

    <div class="article-layout">
      <div class="article-body"><Content /></div>
      <aside class="article-sidebar" aria-label="Informations sur l’article">
        <p class="sidebar-label">Thèmes</p>
        <ul class="tag-list">
          {article.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {relatedArticles.length > 0 && (
          <div class="related-links">
            <p class="sidebar-label">À découvrir aussi</p>
            {relatedArticles.map((related) => (
              <a href={`/actualites/${related.data.slug}/`}>{related.data.title}</a>
            ))}
          </div>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .news-article {
    padding-block: clamp(2.5rem, 7vw, 6rem);
  }

  .back-link {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
  }

  .article-header {
    max-width: 54rem;
    margin: clamp(3rem, 8vw, 6rem) auto clamp(3rem, 7vw, 5rem);
    text-align: center;
  }

  .article-category,
  .sidebar-label {
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 1rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 7vw, 5.7rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .article-excerpt {
    max-width: 42rem;
    margin: 0 auto;
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.25rem);
  }

  .article-dates {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  .demo-notice {
    display: inline-block;
    margin: 1.3rem 0 0;
    padding: 0.45rem 0.75rem;
    background: var(--color-butter);
    font-size: 0.75rem;
    font-weight: 650;
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(0, 42rem) minmax(11rem, 15rem);
    justify-content: center;
    gap: clamp(2rem, 8vw, 6rem);
  }

  .article-body {
    color: var(--color-ink);
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .article-body :global(h2) {
    margin-top: 2.5em;
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .article-body :global(blockquote) {
    margin-inline: 0;
    padding: 0.7rem 1.2rem;
    border-left: 2px solid var(--color-accent);
    background: var(--color-paper-deep);
    color: var(--color-muted);
  }

  .article-sidebar {
    align-self: start;
    padding: 1rem 0;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .sidebar-label { margin: 0 0 0.8rem; }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-list li {
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: 0.7rem;
  }

  .related-links {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.6rem;
  }

  .related-links a {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.2;
    text-decoration: none;
  }

  @media (max-width: 48rem) {
    .article-layout { grid-template-columns: 1fr; }
    .article-sidebar { order: -1; }
  }
</style>
